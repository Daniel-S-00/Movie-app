# TMDB API — Read Access Token (v4 auth, JWT)
# Get yours: https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your_tmdb_read_access_token_here

# Appwrite project
# Get these from https://cloud.appwrite.io/ → your project → Settings
VITE_APPWRITE_PROJECT_ID=your_appwrite_project_id
VITE_APPWRITE_PROJECT_NAME=your_appwrite_project_name
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Appwrite database & collection
VITE_APPWRITE_DATABASE_ID=your_database_id
VITE_APPWRITE_COLLECTION_ID=your_collection_id
